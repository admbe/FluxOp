FLUX_HOST=127.0.0.1
FLUX_PORT=8765
FLUX_DUCKDB_PATH=./data/flux.duckdb
# Web-process bound on waiting for the cross-process DuckDB lease; requests
# return 503 + Retry-After instead of hanging behind a writer. -1 = unbounded.
FLUX_DUCKDB_CONNECT_TIMEOUT_SECONDS=15
# Analytical snapshot architecture (interim plan sections 12-13).
# Web: "direct" reads the mutable database (development default); "snapshot"
# serves reads from published immutable copies and never opens the writer DB.
FLUX_ANALYTICS_SNAPSHOT_MODE=direct
# Worker: publish a validated immutable snapshot after each data-writing job.
FLUX_ANALYTICS_SNAPSHOT_PUBLISH=false
# Blob account for snapshots (production); empty uses the local directory.
FLUX_SNAPSHOT_STORAGE_ACCOUNT_URL=
FLUX_SNAPSHOT_CONTAINER=flux-analytics-snapshots
FLUX_SNAPSHOT_LOCAL_DIRECTORY=./data/snapshots
# API-instance snapshot cache; prefer instance-local storage (/tmp) over /home.
FLUX_SNAPSHOT_CACHE_DIRECTORY=./data/snapshot-cache
FLUX_ANALYTICS_SNAPSHOT_REFRESH_SECONDS=60
FLUX_ANALYTICS_SNAPSHOT_RETENTION=5
# Coalesce publication bursts; 0 disables. Manual CLI publication bypasses.
FLUX_ANALYTICS_SNAPSHOT_MIN_INTERVAL_SECONDS=600
# Keep the newest snapshot per UTC day this long (the analytical backup tier;
# replaces the legacy per-sync backup when publishing is enabled).
FLUX_ANALYTICS_SNAPSHOT_DAILY_RETENTION_DAYS=14
# Staged analytical payloads awaiting the singleton analytics writer.
FLUX_ANALYTICS_STAGING_DIRECTORY=./data/staging
# Crashed-worker sync claims become reclaimable after this lease lapses.
FLUX_SYNC_CLAIM_LEASE_SECONDS=900
# Bounded wait for a pooled operational connection before failing loudly.
FLUX_OPERATIONAL_POOL_TIMEOUT_SECONDS=30
FLUX_AZURE_PROVIDER=local_powershell
FLUX_AZURE_POWERSHELL=pwsh
FLUX_AZURE_TIMEOUT_SECONDS=180
FLUX_AZURE_MANAGEMENT_ENDPOINT=https://management.azure.com
FLUX_MANAGED_IDENTITY_CLIENT_ID=
FLUX_COST_MANAGEMENT_ENABLED=true
FLUX_COST_MANAGEMENT_API_VERSION=2025-03-01
FLUX_COST_MANAGEMENT_TIMEOUT_SECONDS=120
FLUX_COST_MANAGEMENT_MAX_RETRIES=5
FLUX_COST_MANAGEMENT_REQUEST_DELAY_SECONDS=2
FLUX_COST_MANAGEMENT_THROTTLE_COOLDOWN_SECONDS=30
FLUX_COST_HISTORY_INITIAL_DAYS=90
FLUX_COST_HISTORY_REFRESH_DAYS=14
FLUX_COST_HISTORY_CHUNK_DAYS=14
FLUX_COST_DETAILS_BACKFILL_ENABLED=true
FLUX_COST_DETAILS_MAX_REPORTS_PER_RUN=4
FLUX_COST_DETAILS_POLL_INTERVAL_SECONDS=20
FLUX_COST_DETAILS_MAX_POLL_ATTEMPTS=30
FLUX_COST_DETAILS_CURRENT_REFRESH_DAYS=7
FLUX_COST_ANOMALY_LATENCY_DAYS=2
FLUX_COST_ANOMALY_MINIMUM_HISTORY_DAYS=28
FLUX_COST_ANOMALY_MINIMUM_BASELINE_POINTS=4
FLUX_COST_ANOMALY_BASELINE_WEEKS=8
FLUX_COST_ANOMALY_THRESHOLD_K=3.5
FLUX_COST_ANOMALY_MINIMUM_INCREASE=10
FLUX_SYNC_WORKER_MODE=embedded
FLUX_SYNC_WORKER_POLL_SECONDS=5
FLUX_DRIFT_MIN_BASELINE_POINTS=5
FLUX_DRIFT_MAD_THRESHOLD=3
FLUX_RIGHTSIZING_MIN_WINDOW_DAYS=14
FLUX_RIGHTSIZING_MIN_COVERAGE_PERCENT=70
FLUX_RIGHTSIZING_IDLE_CPU_P95=5
FLUX_RIGHTSIZING_IDLE_CPU_MAXIMUM=20
FLUX_RIGHTSIZING_IDLE_NETWORK_P95_BYTES=52428800
FLUX_RIGHTSIZING_REVIEW_CPU_P95=30
FLUX_RIGHTSIZING_MEMORY_REVIEW_PERCENT=80
FLUX_RIGHTSIZING_CPU_DISAGREEMENT_PERCENT=20
FLUX_TELEMETRY_BOOTSTRAP_ROOT=./data/telemetry-bootstrap
FLUX_INTELLIGENCE_SNAPSHOT_AGE_DAYS=30
FLUX_INTELLIGENCE_REQUIRED_TAGS=
FLUX_INTELLIGENCE_TAG_EXCLUDED_TYPES=
FLUX_FINOPS_TOOLKIT_AHB_ENABLED=true
FLUX_FINOPS_TOOLKIT_CACHE_ROOT=./data/finops-toolkit
FLUX_RETAIL_PRICES_ENDPOINT=https://prices.azure.com/api/retail/prices
FLUX_RETAIL_PRICES_API_VERSION=2023-01-01-preview
FLUX_RETAIL_PRICES_TIMEOUT_SECONDS=30
FLUX_RETAIL_PRICES_REQUEST_DELAY_MS=100
FLUX_RETAIL_PRICES_REFRESH_HOURS=24
FLUX_RETAIL_PRICES_HOURS_PER_MONTH=730
FLUX_LOGICMONITOR_ACCOUNT=
FLUX_LOGICMONITOR_GROUP_IDS=4,5
FLUX_LOGICMONITOR_REQUEST_DELAY_MS=250
LM_BEARER_TOKEN=
FLUX_LOGICMONITOR_METRIC_BATCH_SIZE=12
FLUX_LOGICMONITOR_INITIAL_WINDOW_HOURS=8
FLUX_LOGICMONITOR_MAXIMUM_WINDOW_HOURS=12
FLUX_LOGICMONITOR_METRIC_HISTORY_DAYS=14
FLUX_LOGICMONITOR_METRIC_RETENTION_DAYS=30
FLUX_LOGICMONITOR_MAXIMUM_INSTANCES=8
FLUX_BACKUP_STORAGE_ACCOUNT_URL=
FLUX_BACKUP_CONTAINER=flux-backups
FLUX_BACKUP_RETENTION_DAYS=30
FLUX_AI_SLOW_REQUEST_MS=20000
FLUX_AI_PROVIDER=deepseek
FLUX_DEEPSEEK_BASE_URL=https://api.deepseek.com
FLUX_DEEPSEEK_API_KEY=
FLUX_DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
FLUX_DEEPSEEK_BENCHMARK_MODEL=deepseek-v4-pro
FLUX_OPENROUTER_API_KEY=
FLUX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FLUX_OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite
FLUX_OPENROUTER_BENCHMARK_MODEL=openai/gpt-4.1-mini
FLUX_FOUNDRY_ENDPOINT=
FLUX_FOUNDRY_API_KEY=
FLUX_FOUNDRY_API_VERSION=2024-05-01-preview
FLUX_FOUNDRY_CHAT_MODEL=
FLUX_FOUNDRY_BENCHMARK_MODEL=
FLUX_FOUNDRY_ANTHROPIC_ENDPOINT=
FLUX_FOUNDRY_ANTHROPIC_API_VERSION=2023-06-01
FLUX_AUTH_MODE=mock
FLUX_ENTRA_TENANT_ID=
FLUX_ENTRA_ADMIN_ASSIGNMENTS=Flux.Admin
FLUX_ENTRA_READER_ASSIGNMENTS=Flux.Reader
FLUX_AUTH_LOGIN_PATH=/.auth/login/aad
FLUX_AUTH_LOGOUT_PATH=/.auth/logout
FLUX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLUX_DEV_SEED=false
